.vscode/
.DS_Store
.claude/*
!.claude/skills/

# The ACTIVE embedded clank-host binary
# (pkg/provisioner/flysprites/clank-host-linux-amd64) is intentionally TRACKED:
# the deploy embeds whatever is committed, so it must match the code.
# CI (.github/workflows/ci.yml) rebuilds it and `git diff`s to fail any
# stale commit. Rebuild with `make embed-host` (Go pinned by go.mod) and
# commit it alongside clank-host changes. Legacy path stays ignored:
pkg/provisioner/flysprites/clank-host-linux-amd64

# Native clank-host binary produced by `go build ./cmd/clank-host` in
# the worktree root. Test fixture; not for VCS.
/clank-host

# Screenshot files the user shares from the TUI; not for VCS.
screenshot.txt
screenshots/

# `sprite` CLI per-directory active-sprite marker (sprite use). Local state.
.sprite

# Local docker-stack preferences (provider choice, credentials).
# `make docker-up` copies preferences.example.json → preferences.json
# on first run; edits stay per-developer instead of polluting diffs.
docker/preferences.json
