# Pre-baked clank-host image for Fly Machines sandboxes.
#
# Unlike the Daytona image (Dockerfile — a thin overlay on Daytona's
# snapshot), this one owns its whole runtime: Ubuntu LTS + node + bun +
# the agent CLIs, all pinned. The CLI versions are NOT build args —
# the builder stage extracts them from internal/agent's pinned
# constants (via `clank-host print-pins`), so the image can't drift
# from the code pins and /software-manifest stays truthful by
# construction. The 2026-06 stale-embed crash loop and the 2026-07-05
# silent-model-downgrade incident are both structurally impossible
# here: nothing is installed at provision time.
#
# Runtime contract (see entrypoint-fly.sh):
#   - volume mounted at /data = HOME = the user's entire mutable state
#   - binds tcp://[::]:$CLANK_HOST_PORT (default 8080)
#   - all configuration via CLANK_* env
#
# Build:
#   make image-host-fly
#
# Smoke run:
#   docker run --rm -p 8080:8080 -v clank-data:/data \
#     -e CLANK_HOST_AUTH_TOKEN=tkn ghcr.io/acksell/clank-host-fly:dev

# ---- builder ---------------------------------------------------------
FROM golang:1.26-alpine AS builder

WORKDIR /src
RUN apk add --no-cache git ca-certificates
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/clank-host ./cmd/clank-host
# Extract the agent-CLI pins from source — the single source of truth.
RUN /out/clank-host print-pins > /out/pins.env && cat /out/pins.env

# ---- runtime ---------------------------------------------------------
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      git curl wget ca-certificates openssh-client unzip xz-utils \
      ripgrep jq less \
    && rm -rf /var/lib/apt/lists/*

# Node 22 LTS from NodeSource — user projects (Metro/Expo) and the
# agent CLIs need a real node runtime; Ubuntu's apt node is too old.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Toolchain pins, self-described by the clank-host binary — bun and the
# agent CLIs all install at exactly the versions the binary expects.
COPY --from=builder /out/pins.env /etc/clank/pins.env

# bun, system-wide: the runtime HOME is the /data volume, which would
# shadow anything installed into a home directory.
ENV BUN_INSTALL=/opt/bun
RUN . /etc/clank/pins.env \
    && curl -fsSL https://bun.sh/install | bash -s "bun-v${BUN_VERSION}" \
    && ln -s /opt/bun/bin/bun /usr/local/bin/bun \
    && bun --version

# Agent CLIs at the pinned versions, verified in the same layer so a bad
# publish fails the build, not a user session. `claude --version` prints
# "X.Y.Z (Claude Code)".
RUN . /etc/clank/pins.env \
    && bun install -g "@anthropic-ai/claude-code@${CLAUDE_VERSION}" "opencode-ai@${OPENCODE_VERSION}" \
    && ln -s /opt/bun/bin/claude /usr/local/bin/claude \
    && ln -s /opt/bun/bin/opencode /usr/local/bin/opencode \
    && claude --version | grep -qF "${CLAUDE_VERSION}" \
    && opencode --version | grep -qF "${OPENCODE_VERSION}"

COPY --from=builder /out/clank-host /usr/local/bin/clank-host
COPY cmd/clank-host/entrypoint-fly.sh /usr/local/bin/entrypoint-fly.sh
RUN chmod 0755 /usr/local/bin/clank-host /usr/local/bin/entrypoint-fly.sh

# /data is the machine's volume mount point; created so a volume-less
# smoke run still works. HOME set here as well as in the entrypoint so
# `fly machine exec` shells land in the right place.
RUN mkdir -p /data
ENV HOME=/data \
    CLANK_HOST_PORT=8080 \
    CLANK_HOST_DATA_DIR=/data/.clank-host
WORKDIR /data
EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/entrypoint-fly.sh"]
